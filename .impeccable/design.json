  "narrative": {
    "northStar": "The Connected Tool Network",
    "overview": "A tensegrity network makes independent Moodle tools understandable as connected ways to work. Concrete surfaces and carbon structure give practical content a clear frame; vermilion marks connections and actions. Geometry serves navigation, while the existing MoodlIA logo remains the product identifier.",
    "keyCharacteristics": [
      "Functional diagrams with real tool links.",
      "Compact display headings and readable bilingual explanation.",
      "Ruled editorial rows, concrete surfaces, and selective carbon feature panels."
    ],
    "rules": [],
    "dos": [
      "Do use semantic CSS properties so light and dark themes stay aligned.",
      "Do keep diagram labels as readable, keyboard-accessible links.",
      "Do preserve translated equivalents and a visible focus ring.",
      "Do reserve space below network geometry for its caption."
    ],
    "donts": [
      "Don't turn the illustrative network into a live connection indicator.",
      "Don't introduce looping motion or bypass reduced-motion preferences.",
      "Don't replace ruled directories with a repeated floating-card treatment.",
      "Don't treat the old photo collage or paper crank as current design authority."
    ]
  }
}
